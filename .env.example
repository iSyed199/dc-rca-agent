# ==============================================================================
# Data Commons RCA Agent Environment Configuration Template
# Copy this file to '.env' and adjust values for local or cloud deployments.
# ==============================================================================

# --- core settings ---
# The GCP project ID containing the Batch execution logs
RCA_PROJECT_ID=datcom-import-automation-prod

# The target GCS bucket containing importer results
RCA_IMPORTS_BUCKET=datcom-prod-imports

# Number of historical days to scan during log synchronization
RCA_SYNC_WINDOW_DAYS=14

# --- database backend settings ---
# Options: 'LOCAL' (reads/writes locally to JSON file) or 'FIRESTORE' (GCP Firestore mode)
DATABASE_TYPE=LOCAL

# --- optional: upstream source verification credentials ---
# Optional: Used only if performing live upstream API source checks for specific agencies
RCA_CENSUS_API_KEY=
RCA_FRED_API_KEY=
RCA_EIA_API_KEY=

